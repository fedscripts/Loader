SpeedSection:Toggle("Speed Modifier", false, "MoveSpeed", function(v)
    MovementSettings.SpeedEnabled = v
    local hum = getHumanoid()
    if hum then
        hum.WalkSpeed = v and MovementSettings.WalkSpeed or defaultWalkSpeed
    end
end)

SpeedSection:Slider("Walk Speed", 1, 250, 16, 1, "MoveWalkSpeed", function(v)
    MovementSettings.WalkSpeed = v
    if MovementSettings.SpeedEnabled then
        local hum = getHumanoid()
        if hum then hum.WalkSpeed = v end
    end
end)

local ExtrasSection = MovementTab:Section("Extras")

ExtrasSection:Toggle("Fake Lag", false, "MoveFakeLag", function(v)
    MovementSettings.FakeLag = v
    if v then startFakeLag() else stopFakeLag() end
end)

ExtrasSection:Toggle("Horizontal Spinbot", false, "MoveSpinbot", function(v)
    MovementSettings.SpinbotHoriz = v
    if horizSpinConn then horizSpinConn:Disconnect() horizSpinConn = nil end
    if v then
        horizSpinConn = RunService.Heartbeat:Connect(spinHoriz)
    else
        horizSpinAngle = 0
    end
end)

ExtrasSection:Toggle("Anti-Fling", false, "MoveAntiFling", function(v)
    if not v then
        if _G.FedAntiFlingConn then _G.FedAntiFlingConn:Disconnect() _G.FedAntiFlingConn = nil end
        return
    end
    if not _G.FedAntiFlingConn then
        _G.FedAntiFlingConn = RunService.Heartbeat:Connect(function()
            local h = getHRP()
            if h and h.AssemblyLinearVelocity.Magnitude > 200 then
                h.AssemblyLinearVelocity  = Vector3.zero
                h.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end
end)

ExtrasSection:Toggle("Auto Reset (Loop)", false, "MoveAutoReset", function(v)
    MovementSettings.AutoReset = v
    if autoResetThread then task.cancel(autoResetThread) autoResetThread = nil end
    if v then
        autoResetThread = task.spawn(function()
            while MovementSettings.AutoReset do
                local hum = getHumanoid()
                if hum then hum.Health = 0 end
                task.wait(2)
            end
        end)
    end
end)

