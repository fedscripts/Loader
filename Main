local WaypointInfoSec = WaypointsTab:Section("Info")
WaypointInfoSec:Label("Save up to 5 positions. Save Here stores your spot, Go teleports back, Clear removes the slot.")

local wpSlots = {}

local function makeWaypointSlot(i)
    local sec = WaypointsTab:Section("Slot " .. i)

    local slotLbl = sec:Label("Slot " .. i .. ": empty")

    sec:Button("Save Here — Slot " .. i, function()
        local hrp = getHRP()
        if not hrp then return end
        wpSlots[i] = hrp.CFrame
        pcall(function() slotLbl:Set("Slot " .. i .. ": saved") end)
    end)

    sec:Button("Go — Slot " .. i, function()
        if not wpSlots[i] then return end
        local hrp = getHRP()
        if hrp then hrp.CFrame = wpSlots[i] end
    end)

    sec:Button("Clear — Slot " .. i, function()
        wpSlots[i] = nil
        pcall(function() slotLbl:Set("Slot " .. i .. ": empty") end)
    end)
end

for i = 1, 5 do makeWaypointSlot(i) end

