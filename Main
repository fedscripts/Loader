    "Head", "UpperTorso", "LowerTorso",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperArm",  "LeftLowerArm",  "LeftHand",
    "RightUpperLeg", "RightLowerLeg", "RightFoot",
    "LeftUpperLeg",  "LeftLowerLeg",  "LeftFoot",
    "HumanoidRootPart",
}

local function isVisible(part)
    if not part then return false end
    local origin    = camera.CFrame.Position
    local direction = (part.Position - origin)
    local params    = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {localPlayer.Character, part.Parent}
    local result = Workspace:Raycast(origin, direction, params)
    return result == nil
end

local function isAlive(player)
    local c = player.Character
    if not c then return false end
    local hum = c:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function getBonePart(character, boneName)
    return character:FindFirstChild(boneName)
end

local function findPlayerByNameOrDisplay(query)
    if not query or query == "" then return nil end
    local q = query:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == q then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.DisplayName:lower() == q then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(q, 1, true) then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.DisplayName:lower():find(q, 1, true) then return p end
    end
    return nil
end

local function parsePlayerList(str)
    local names = {}
    for name in str:gmatch("[^,]+") do
        name = name:match("^%s*(.-)%s*$")
        if name ~= "" then names[#names+1] = name end
    end
    return names
end

local function getClosestPlayer()
    local hrp = getHRP()
    if not hrp then return nil end
    local closest, bestDist = nil, math.huge

    if not AimbotSettings.RageAim then
        local mousePos = UserInputService:GetMouseLocation()
        for _, player in ipairs(Players:GetPlayers()) do
            if player == localPlayer then continue end
            if not isAlive(player) then continue end
            if AimbotSettings.TeamCheck and player.Team == localPlayer.Team then continue end
            local character = player.Character
            if not character then continue end
            local head = character:FindFirstChild("Head")
            if not head then continue end
            if AimbotSettings.WallCheck and not isVisible(head) then continue end
            local screenPos, onScreen = camera:WorldToScreenPoint(head.Position)
            if onScreen and screenPos.Z > 0 then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if dist < bestDist and dist <= AimbotSettings.FOV then
                    bestDist = dist
                    closest  = player
                end
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player == localPlayer then continue end
            if not isAlive(player) then continue end
            if AimbotSettings.TeamCheck and player.Team == localPlayer.Team then continue end
            local character = player.Character
            if not character then continue end
            local tHRP = character:FindFirstChild("HumanoidRootPart")
            if not tHRP then continue end
            local dist = (hrp.Position - tHRP.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                closest  = player
            end
        end
    end
    return closest
end

-- ─────────────────────────────────────────────────
--  ESP
-- ─────────────────────────────────────────────────
local espBoxDrawings      = {}
local espNameDrawings     = {}
local espHealthBGDrawings = {}
local espHealthDrawings   = {}
local espDistDrawings     = {}
local espTracerDrawings   = {}
local espSkeletonConns    = {}
local espSkeletonBones    = {}

local BONE_PAIRS = {
    {"Head","UpperTorso","Head","Torso"},
    {"UpperTorso","LowerTorso",nil,nil},
    {"UpperTorso","LeftUpperArm","Torso","Left Arm"},
    {"LeftUpperArm","LeftLowerArm",nil,nil},
    {"LeftLowerArm","LeftHand",nil,nil},
    {"UpperTorso","RightUpperArm","Torso","Right Arm"},
    {"RightUpperArm","RightLowerArm",nil,nil},
    {"RightLowerArm","RightHand",nil,nil},
    {"LowerTorso","LeftUpperLeg","Torso","Left Leg"},
    {"LeftUpperLeg","LeftLowerLeg",nil,nil},
    {"LeftLowerLeg","LeftFoot",nil,nil},
    {"LowerTorso","RightUpperLeg","Torso","Right Leg"},
    {"RightUpperLeg","RightLowerLeg",nil,nil},
    {"RightLowerLeg","RightFoot",nil,nil},
}

local function nd(class, props)
    local d = Drawing.new(class)
    for k, v in pairs(props) do d[k] = v end
    return d
end

local function createESPForPlayer(player)
    if player == localPlayer then return end
    if espBoxDrawings[player] then return end

    espBoxDrawings[player]      = nd("Square", {Color=ESPSettings.BoxColor,     Thickness=1, Filled=false, Visible=false})
    espNameDrawings[player]     = nd("Text",   {Color=ESPSettings.NameColor,    Size=13, Center=true, Outline=true, Visible=false, Font=3})
    espHealthBGDrawings[player] = nd("Line",   {Color=Color3.new(0,0,0),        Thickness=3, Visible=false})
    espHealthDrawings[player]   = nd("Line",   {Color=Color3.new(0,1,0),        Thickness=1, Visible=false})
    espDistDrawings[player]     = nd("Text",   {Color=Color3.new(0.7,0.7,0.7),  Size=11, Center=true, Outline=true, Visible=false, Font=3})
    espTracerDrawings[player]   = nd("Line",   {Color=ESPSettings.TracerColor,  Thickness=1, Visible=false})

    local bones = {}
    for i = 1, #BONE_PAIRS do
        bones[i] = nd("Line", {Color=ESPSettings.SkeletonsColor, Thickness=1, Visible=false})
    end
    espSkeletonBones[player] = bones

    local function updateSkeleton()
        local vis = ESPSettings.ShowSkeletons
        local character = player.Character
        if not vis or not character then
            for _, b in ipairs(bones) do b.Visible = false end
            return
        end
        local isR15 = character:FindFirstChild("UpperTorso") ~= nil
        local col   = ESPSettings.SkeletonsColor
        for i, pair in ipairs(BONE_PAIRS) do
            local b  = bones[i]
            local p1 = isR15 and character:FindFirstChild(pair[1]) or (pair[3] and character:FindFirstChild(pair[3]))
            local p2 = isR15 and character:FindFirstChild(pair[2]) or (pair[4] and character:FindFirstChild(pair[4]))
            if p1 and p2 then
                local s1, v1 = camera:WorldToViewportPoint(p1.Position)
                local s2, v2 = camera:WorldToViewportPoint(p2.Position)
                if v1 and v2 and s1.Z > 0 and s2.Z > 0 then
                    b.From    = Vector2.new(s1.X, s1.Y)
                    b.To      = Vector2.new(s2.X, s2.Y)
                    b.Color   = col
                    b.Visible = true
                else
                    b.Visible = false
                end
            else
                b.Visible = false
            end
        end
    end

    espSkeletonConns[player] = RunService.RenderStepped:Connect(updateSkeleton)
end

local function removeESPForPlayer(player)
    if espBoxDrawings[player]      then espBoxDrawings[player]:Remove()      espBoxDrawings[player]      = nil end
    if espNameDrawings[player]     then espNameDrawings[player]:Remove()     espNameDrawings[player]     = nil end
    if espHealthBGDrawings[player] then espHealthBGDrawings[player]:Remove() espHealthBGDrawings[player] = nil end
    if espHealthDrawings[player]   then espHealthDrawings[player]:Remove()   espHealthDrawings[player]   = nil end
    if espDistDrawings[player]     then espDistDrawings[player]:Remove()     espDistDrawings[player]     = nil end
    if espTracerDrawings[player]   then espTracerDrawings[player]:Remove()   espTracerDrawings[player]   = nil end
    if espSkeletonConns[player]    then espSkeletonConns[player]:Disconnect() espSkeletonConns[player]   = nil end
    if espSkeletonBones[player] then
        for _, b in ipairs(espSkeletonBones[player]) do b:Remove() end
        espSkeletonBones[player] = nil
    end
end

local function updateESPForPlayer(player)
    local box      = espBoxDrawings[player]
    local nameDraw = espNameDrawings[player]
    local hpBG     = espHealthBGDrawings[player]
    local hpBar    = espHealthDrawings[player]
    local distDraw = espDistDrawings[player]
    local tracer   = espTracerDrawings[player]
    if not box then return end

    local function hideAll()
        box.Visible      = false
        nameDraw.Visible = false
        hpBG.Visible     = false
        hpBar.Visible    = false
        distDraw.Visible = false
        tracer.Visible   = false
    end

    if not player or not player.Parent then hideAll() return end

    local character = player.Character
    if not character then hideAll() return end
    local hrp      = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid or humanoid.Health <= 0 then hideAll() return end

    local rootPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
    if not onScreen or rootPos.Z <= 0 then hideAll() return end

    local head   = character:FindFirstChild("Head")
    local headV  = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or rootPos
    local legV   = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

    local boxH   = math.abs(headV.Y - legV.Y)
    local boxW   = 2350 / rootPos.Z
    local bPos   = Vector2.new(rootPos.X - boxW / 2, rootPos.Y - boxH / 2)
    local bSize  = Vector2.new(boxW, boxH)
    local col    = ESPSettings.BoxColor

    if ESPSettings.ShowBox then
        box.Position = bPos
        box.Size     = bSize
        box.Color    = col
        box.Visible  = true
    else
        box.Visible  = false
    end

    if ESPSettings.ShowName then
        nameDraw.Text     = "[" .. player.Name:upper() .. "]"
        nameDraw.Position = Vector2.new(rootPos.X, bPos.Y - 20)
        nameDraw.Color    = ESPSettings.NameColor
        nameDraw.Visible  = true
    else
        nameDraw.Visible  = false
    end

    if ESPSettings.ShowHealth then
        local pct  = humanoid.Health / math.max(humanoid.MaxHealth, 1)
        local barX = bPos.X - 5
        hpBG.From  = Vector2.new(barX, bPos.Y + bSize.Y)
        hpBG.To    = Vector2.new(barX, bPos.Y)
        hpBG.Visible = true
        hpBar.From  = Vector2.new(barX, bPos.Y + bSize.Y)
        hpBar.To    = Vector2.new(barX, bPos.Y + bSize.Y - pct * bSize.Y)
        hpBar.Color = Color3.new(1 - pct, pct, 0)
        hpBar.Visible = true
    else
        hpBG.Visible  = false
        hpBar.Visible = false
    end

    if ESPSettings.ShowDistance then
        local dist = (camera.CFrame.Position - hrp.Position).Magnitude
        distDraw.Text     = string.format("[%.0fm]", dist)
        distDraw.Position = Vector2.new(rootPos.X, bPos.Y + bSize.Y + 4)
        distDraw.Visible  = true
    else
        distDraw.Visible  = false
    end

    if ESPSettings.ShowTracer then
        local originY = ESPSettings.TracerPosition == "Top"    and 0
                     or ESPSettings.TracerPosition == "Middle" and camera.ViewportSize.Y / 2
                     or camera.ViewportSize.Y
        tracer.From    = Vector2.new(camera.ViewportSize.X / 2, originY)
        tracer.To      = Vector2.new(rootPos.X, rootPos.Y)
        tracer.Color   = ESPSettings.TracerColor
        tracer.Visible = true
    else
        tracer.Visible = false
    end
end

-- ─────────────────────────────────────────────────
--  MOVEMENT INTERNALS
-- ─────────────────────────────────────────────────
local flyForce, flyConn  = nil, nil
local horizSpinConn      = nil
local horizSpinAngle     = 0
local infJumpConn        = nil
local bhopConn           = nil
local autoResetThread    = nil
local defaultGravity     = Workspace.Gravity
local defaultWalkSpeed   = 16

local forceTHPConn = nil
local function startForceThirdPerson()
    if forceTHPConn then return end
    for _, v in ipairs(localPlayer.PlayerScripts:GetDescendants()) do
        if v:IsA("LocalScript") and (v.Name:lower():find("camera") or v.Name:lower():find("zoom") or v.Name:lower():find("lock")) then
            v.Disabled = true
        end
    end
    localPlayer.CameraMode = Enum.CameraMode.Classic
    camera.CameraType      = Enum.CameraType.Custom
    forceTHPConn = RunService.RenderStepped:Connect(function()
        if not CameraSettings.ForceTHP then
            forceTHPConn:Disconnect()
            forceTHPConn = nil
            return
        end
        localPlayer.CameraMode = Enum.CameraMode.Classic
        camera.CameraType      = Enum.CameraType.Custom
        local hum = getHumanoid()
        if hum then camera.CameraSubject = hum end
        if camera.CFrame == camera.Focus then
            local hrp = getHRP()
            if hrp then
                camera.CFrame = CFrame.new(hrp.Position + Vector3.new(0, 5, 10), hrp.Position)
            end
        end
    end)
end

local function stopForceThirdPerson()
    CameraSettings.ForceTHP = false
    if forceTHPConn then forceTHPConn:Disconnect() forceTHPConn = nil end
    camera.CameraType = Enum.CameraType.Custom
end

local function startFlying()
    if flyForce then return end
    local hrp = getHRP()
    local hum = getHumanoid()
    if not hrp or not hum then return end
    Workspace.Gravity = 0
    flyForce = Instance.new("BodyVelocity")
    flyForce.Velocity  = Vector3.zero
    flyForce.MaxForce  = Vector3.new(math.huge, math.huge, math.huge)
    flyForce.Parent    = hrp
    hum:ChangeState(Enum.HumanoidStateType.Flying)
    flyConn = RunService.Heartbeat:Connect(function()
        local hrp2 = getHRP()
        if not hrp2 or not flyForce then return end
        local cam = camera.CFrame
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W)           then dir += cam.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)           then dir -= cam.LookVector  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)           then dir -= cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)           then dir += cam.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then dir += Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0,1,0) end
        flyForce.Velocity = (dir.Magnitude > 0 and dir.Unit or Vector3.zero) * MovementSettings.FlySpeed
    end)
end

local function stopFlying()
    if flyForce then flyForce:Destroy() flyForce = nil end
    if flyConn  then flyConn:Disconnect()  flyConn  = nil end
    Workspace.Gravity = defaultGravity
    local hum = getHumanoid()
    if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
end

local function spinHoriz(dt)
    local hrp = getHRP()
    if not hrp then return end
    horizSpinAngle = horizSpinAngle + math.rad(360 * dt * 3)
    local pos = hrp.Position
    hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, horizSpinAngle, 0)
end

-- ─────────────────────────────────────────────────
--  FAKE LAG
-- ─────────────────────────────────────────────────
local fakeLagThread = nil
local fakeLagFrozen = false

local function startFakeLag()
    if fakeLagThread then return end
    fakeLagThread = task.spawn(function()
        while MovementSettings.FakeLag do
            local hrp = getHRP()
            if hrp then
                hrp.Anchored  = true
                fakeLagFrozen = true
            end
            task.wait(0.5)
            if hrp then
                hrp.Anchored  = false
                fakeLagFrozen = false
            end
            task.wait(0.5)
        end
        local hrp = getHRP()
        if hrp then hrp.Anchored = false end
        fakeLagFrozen = false
        fakeLagThread = nil
    end)
end

local function stopFakeLag()
    MovementSettings.FakeLag = false
    if fakeLagThread then
        task.cancel(fakeLagThread)
        fakeLagThread = nil
    end
    local hrp = getHRP()
    if hrp then hrp.Anchored = false end
    fakeLagFrozen = false
end

-- ─────────────────────────────────────────────────
--  TELEPORT INTERNALS
-- ─────────────────────────────────────────────────
local loopTeleportConn = nil
local loopSpookConn    = nil
local viewPlayerConn   = nil
local spectateConn     = nil

local function teleportToPlayer(name)
    local target = findPlayerByNameOrDisplay(name)
    if not target then return end
    local hrp  = getHRP()
    local tHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if hrp and tHRP then
        hrp.CFrame = tHRP.CFrame * CFrame.new(0, 0, 4)
    end
end

-- ─────────────────────────────────────────────────
--  AUTO CLICKER INTERNALS
-- ─────────────────────────────────────────────────
local autoClickConn = nil

local function startAutoClicker()
    if autoClickConn then return end
    autoClickConn = task.spawn(function()
        while AutoClickerSettings.Enabled do
            mouse1click()
            task.wait(1 / math.max(AutoClickerSettings.CPS, 1))
        end
    end)
end

local function stopAutoClicker()
    AutoClickerSettings.Enabled = false
    autoClickConn = nil
end

-- ─────────────────────────────────────────────────
--  WORLD SETTINGS
-- ─────────────────────────────────────────────────
local MATERIAL_MAP = {
    ["Smooth Plastic"] = Enum.Material.SmoothPlastic,
    ["Brick"]          = Enum.Material.Brick,
    ["Sand"]           = Enum.Material.Sand,
    ["Ice"]            = Enum.Material.Ice,
    ["Wood"]           = Enum.Material.Wood,
    ["Neon"]           = Enum.Material.Neon,
    ["Metal"]          = Enum.Material.Metal,
    ["Grass"]          = Enum.Material.Grass,
    ["Glass"]          = Enum.Material.Glass,
}

local savedPartData = {}

local function saveOriginalParts()
    savedPartData = {}
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            savedPartData[v] = {
                Material  = v.Material,
                Color     = v.Color,
                BrickColor = v.BrickColor,
                -- Also save texture so we can properly restore
                TextureID = v:FindFirstChildOfClass("SpecialMesh") and v:FindFirstChildOfClass("SpecialMesh").TextureId or nil,
            }
        end
    end
end

local function applyWorld(material, color)
    local char = getCharacter()
    local hrp  = getHRP()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            if v == hrp then continue end
            if char and v:IsDescendantOf(char) then continue end
            v.Material = material
            v.Color    = color
            -- Clear any existing textures on parts to avoid layering issues
            for _, tex in ipairs(v:GetChildren()) do
                if tex:IsA("Texture") or tex:IsA("Decal") then
                    tex:Destroy()
                end
            end
        end
    end
end

local function resetWorld()
    for part, data in pairs(savedPartData) do
        if part and part.Parent then
            part.Material   = data.Material
            part.Color      = data.Color
            part.BrickColor = data.BrickColor
        end
    end
end

local function clearAllWorld()
    local char = getCharacter()
    local hrp  = getHRP()
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            if v == hrp then continue end
            if char and v:IsDescendantOf(char) then continue end
            v.Material   = Enum.Material.SmoothPlastic
            v.Color      = Color3.fromRGB(163, 162, 165)
            v.BrickColor = BrickColor.new("Medium stone grey")
            -- Clear textures so retexture is clean
            for _, tex in ipairs(v:GetChildren()) do
                if tex:IsA("Texture") or tex:IsA("Decal") then
                    tex:Destroy()
                end
            end
        end
    end
end

-- ─────────────────────────────────────────────────
--  LIGHTING / TIME OF DAY
-- ─────────────────────────────────────────────────
local function setTimeOfDay(preset)
    if preset == "Daytime" then
        Lighting.TimeOfDay        = "12:00:00"
        Lighting.Brightness       = 2
        Lighting.Ambient          = Color3.fromRGB(178, 178, 178)
        Lighting.OutdoorAmbient   = Color3.fromRGB(128, 128, 128)
        Lighting.FogEnd           = 100000
    elseif preset == "Sunset" then
        Lighting.TimeOfDay        = "18:30:00"
        Lighting.Brightness       = 1.2
        Lighting.Ambient          = Color3.fromRGB(200, 120, 60)
        Lighting.OutdoorAmbient   = Color3.fromRGB(170, 90, 40)
        Lighting.FogEnd           = 60000
    elseif preset == "Night" then
        Lighting.TimeOfDay        = "00:00:00"
        Lighting.Brightness       = 0
        Lighting.Ambient          = Color3.fromRGB(20, 20, 30)
        Lighting.OutdoorAmbient   = Color3.fromRGB(10, 10, 20)
        Lighting.FogEnd           = 10000
    end
end

-- ─────────────────────────────────────────────────
--  PROJECTION SORCERY
-- ─────────────────────────────────────────────────
local projRecordConn  = nil
local projPlayConn    = nil
local projGhostParts  = {}

local function clearGhostParts()
    for _, p in ipairs(projGhostParts) do
        if p and p.Parent then p:Destroy() end
    end
    projGhostParts = {}
end

local function startProjectionRecording()
    if ProjectionSettings.IsRecording then return end
    ProjectionSettings.IsRecording = true
    ProjectionSettings.RecordedFrames = {}
    local frameInterval = 1 / ProjectionSettings.FrameCount
    local elapsed = 0
    clearGhostParts()

    projRecordConn = RunService.Heartbeat:Connect(function(dt)
        if not ProjectionSettings.IsRecording then
            projRecordConn:Disconnect()
            projRecordConn = nil
            return
        end
        elapsed = elapsed + dt
        if elapsed >= frameInterval then
            elapsed = elapsed - frameInterval
            local hrp = getHRP()
            if hrp then
                local frameIndex = #ProjectionSettings.RecordedFrames + 1
                ProjectionSettings.RecordedFrames[frameIndex] = hrp.CFrame

                -- Spawn a ghost at each recorded frame position
                local ghost = Instance.new("Part")
                ghost.Anchored        = true
                ghost.CanCollide      = false
                ghost.Transparency    = 0.75
                ghost.BrickColor      = BrickColor.new("Bright blue")
                ghost.Material        = Enum.Material.Neon
                ghost.Size            = Vector3.new(2, 5, 1)
                ghost.CFrame          = hrp.CFrame
                ghost.Parent          = Workspace
                ghost.Name            = "ProjGhost_" .. frameIndex
                projGhostParts[frameIndex] = ghost

                if frameIndex >= ProjectionSettings.FrameCount then
                    ProjectionSettings.IsRecording = false
                    if projRecordConn then
                        projRecordConn:Disconnect()
                        projRecordConn = nil
                    end
                end
            end
        end
    end)
end

local function stopProjectionRecording()
    ProjectionSettings.IsRecording = false
    if projRecordConn then
        projRecordConn:Disconnect()
        projRecordConn = nil
    end
end

local function playbackProjection()
    if ProjectionSettings.IsPlaying then return end
    if #ProjectionSettings.RecordedFrames == 0 then return end
    ProjectionSettings.IsPlaying = true
    ProjectionSettings.CurrentFrame = 1

    local frameInterval = (1 / ProjectionSettings.FrameCount) / math.max(ProjectionSettings.PlaybackSpeed, 0.1)
    local elapsed = 0

    projPlayConn = RunService.Heartbeat:Connect(function(dt)
        if not ProjectionSettings.IsPlaying then
            projPlayConn:Disconnect()
            projPlayConn = nil
            return
        end
        elapsed = elapsed + dt
        if elapsed >= frameInterval then
            elapsed = elapsed - frameInterval
            local frameIdx = ProjectionSettings.CurrentFrame
            local cf = ProjectionSettings.RecordedFrames[frameIdx]
            if cf then
                local hrp = getHRP()
                if hrp then
                    hrp.CFrame = cf
                end
            end
            ProjectionSettings.CurrentFrame = ProjectionSettings.CurrentFrame + 1
            if ProjectionSettings.CurrentFrame > #ProjectionSettings.RecordedFrames then
                if ProjectionSettings.LoopPlayback then
                    ProjectionSettings.CurrentFrame = 1
                else
                    ProjectionSettings.IsPlaying = false
                    if projPlayConn then
                        projPlayConn:Disconnect()
                        projPlayConn = nil
                    end
                end
            end
        end
    end)
end

local function stopPlayback()
    ProjectionSettings.IsPlaying = false
    if projPlayConn then
        projPlayConn:Disconnect()
        projPlayConn = nil
    end
end

