local PlayerTargetSec = PlayersTab:Section("Target")

PlayerTargetSec:Label("Enter username or display name. Partial matches work. Separate with commas.")

PlayerTargetSec:Textbox("Target Player(s)", false, function(v)
    TeleportSettings.TargetPlayer = v
end)

local searchStatusLabel = PlayerTargetSec:Label("Status: Enter a name above")

local PlayerActionsSec = PlayersTab:Section("Actions")

PlayerActionsSec:Button("Teleport to Player", function()
    local names = parsePlayerList(TeleportSettings.TargetPlayer)
    if #names == 0 then return end
    teleportToPlayer(names[1])
end)

PlayerActionsSec:Toggle("Loop Teleport", false, "PlayersLoopTp", function(v)
    TeleportSettings.LoopTeleport = v
    if loopTeleportConn then loopTeleportConn:Disconnect() loopTeleportConn = nil end
    if v then
        loopTeleportConn = RunService.Heartbeat:Connect(function()
            local names = parsePlayerList(TeleportSettings.TargetPlayer)
            for _, name in ipairs(names) do teleportToPlayer(name) end
        end)
    end
end)

PlayerActionsSec:Toggle("Loop Spook", false, "PlayersLoopSpook", function(v)
    TeleportSettings.LoopSpook = v
    if loopSpookConn then task.cancel(loopSpookConn) loopSpookConn = nil end
    if v then
        loopSpookConn = task.spawn(function()
            while TeleportSettings.LoopSpook do
                local names = parsePlayerList(TeleportSettings.TargetPlayer)
                local hrp   = getHRP()
                if hrp and #names > 0 then
                    local origin = hrp.CFrame
                    for _, name in ipairs(names) do
                        local target = findPlayerByNameOrDisplay(name)
                        local tHRP   = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
                        if tHRP then
                            local hrp2 = getHRP()
                            if hrp2 then hrp2.CFrame = tHRP.CFrame * CFrame.new(0, 0, -4) end
                            task.wait(0.3)
                            local hrp3 = getHRP()
                            if hrp3 then hrp3.CFrame = origin end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)

PlayerActionsSec:Toggle("Spectate Player", false, "PlayersSpectate", function(v)
    TeleportSettings.SpectatePlayer = v
    if spectateConn then spectateConn:Disconnect() spectateConn = nil end
    if v then
        spectateConn = RunService.RenderStepped:Connect(function()
            local names  = parsePlayerList(TeleportSettings.TargetPlayer)
            if #names == 0 then return end
            local target = findPlayerByNameOrDisplay(names[1])
            local tHum   = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
            if tHum then camera.CameraSubject = tHum end
        end)
    else
        local hum = getHumanoid()
        if hum then camera.CameraSubject = hum end
    end
end)

PlayerActionsSec:Toggle("Stare At Player", false, "PlayersViewCam", function(v)
    TeleportSettings.ViewPlayer = v
    if viewPlayerConn then viewPlayerConn:Disconnect() viewPlayerConn = nil end
    if v then
        viewPlayerConn = RunService.RenderStepped:Connect(function()
            local names  = parsePlayerList(TeleportSettings.TargetPlayer)
            if #names == 0 then return end
            local target = findPlayerByNameOrDisplay(names[1])
            local tHead  = target and target.Character and target.Character:FindFirstChild("Head")
            if tHead then camera.CFrame = CFrame.new(camera.CFrame.Position, tHead.Position) end
        end)
    else
        camera.CameraType = Enum.CameraType.Custom
    end
end)

