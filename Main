    FlySpeed         = 50,
    InfJump          = false,
    SpeedEnabled     = false,
    WalkSpeed        = 16,
    BHop             = false,
    FakeLag          = false,
    SpinbotHoriz     = false,
    AutoReset        = false,
}

local TeleportSettings = {
    Waypoints       = {},
    SpawnPoint      = nil,
    TargetPlayer    = "",
    LoopTeleport    = false,
    LoopSpook       = false,
    ViewPlayer      = false,
    SpectatePlayer  = false,
}

