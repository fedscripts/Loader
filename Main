    FOV            = 70,
    ForceFP        = false,
    ForceTHP       = false,
}

local ESPSettings = {
    Enabled        = true,
    ShowBox        = false,
    BoxColor       = Color3.fromRGB(255, 255, 255),
    ShowName       = false,
    NameColor      = Color3.fromRGB(255, 255, 255),
    ShowHealth     = false,
    ShowDistance   = false,
    ShowSkeletons  = false,
    SkeletonsColor = Color3.fromRGB(255, 255, 255),
    ShowTracer     = false,
    TracerColor    = Color3.fromRGB(255, 255, 255),
