local function u757_slots()
	local v755 = nil
	for _, v756 in pairs(Workspace.Slots:GetChildren()) do
		if v756.SlotHandle.LightBall.Material ~= Enum.Material.Neon then
			v755 = false
			break
		end
		v755 = true
	end
	return v755
end

local function SNOWship_local(part)
	if part and typeof(part) == "Instance" then
		local dist = LocalPlayer:DistanceFromCharacter(part.Position)
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and dist <= 30 then
			local _SetNetworkOwnerLocal = ReplicatedStorage:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
			local from = LocalPlayer.Character.HumanoidRootPart.Position
			local to = part.Position
			local unit = (to - from).Unit
			local right = unit:Cross(Vector3.new(0,1,0))
			local up = right:Cross(unit)
			_SetNetworkOwnerLocal:FireServer(part, CFrame.fromMatrix(from, right, up))
		end
	end
end

local savedSpinPos = nil
local automakecointoggle = nil
automakecointoggle = coinSec:Toggle("Auto-Spin", false, "AutoSpinCoins", function(p767)
	_G.AutoFarmCoins = p767
	if p767 then
		while _G.AutoFarmCoins do
			if u757_slots() then
				savedSpinPos = GetPlayerCFrame()
				local u768 = nil
				local v769 = task.spawn(function()
					while true do
						if u768 then
							TeleportPlayer(u768.CFrame + Vector3.new(0, 5, 0))
							task.wait(0.2)
							SNOWship_local(u768)
						end
						task.wait()
					end
				end)
				for _, v773 in pairs(Workspace.Slots:GetChildren()) do
					u768 = v773.SlotHandle.Handle
					u768.CanCollide = false
					local v774 = u768
					for _ = 1, 5 do task.wait(0.2) end
					v774.CanCollide = true
					if not u757_slots() then break end
				end
				task.cancel(v769)
				if savedSpinPos then TeleportPlayer(savedSpinPos) end
			end
			task.wait(5)
		end
	end
end)

