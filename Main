local FLING_GAME_ID = 6961824067

local isFlingGame = game.PlaceId == FLING_GAME_ID

-- Executor name detection (covers most popular executors)
local function GetExecutorName()
    if identifyexecutor then
        local name = identifyexecutor()
        if name and name ~= "" then return name end
    end
    if syn and syn.request then return "Synapse X" end
    if KRNL_LOADED then return "Krnl" end
    if CARBONARA then return "Carbon" end
    if MACSPLOIT_LOADED then return "MacSploit" end
    if getexecutorname then
        local name = getexecutorname()
        if name and name ~= "" then return name end
    end
    return "Unknown Executor"
end

local ExecutorName = GetExecutorName()

