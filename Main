--// ================================================================
--// Animation Setup
--// ================================================================
local LoadingInfo = TweenInfo.new(Config.Animation.TweenDuration, Enum.EasingStyle.Sine)
local FadeInfo    = TweenInfo.new(Config.Animation.FadeDuration)

local BGAppear          = TweenService:Create(BackgroundBar,  FadeInfo,    {BackgroundTransparency = 0.6})
local BGDisappear       = TweenService:Create(BackgroundBar,  FadeInfo,    {BackgroundTransparency = 1})
local BackdropAppear    = TweenService:Create(Backdrop,       FadeInfo,    {BackgroundTransparency = 0.4})
local BackdropDisappear = TweenService:Create(Backdrop,       FadeInfo,    {BackgroundTransparency = 1})
local BarDisappear      = TweenService:Create(LoadingBar,     LoadingInfo, {BackgroundTransparency = 1})
local MessageClear      = TweenService:Create(Message,        FadeInfo,    {TextTransparency = 1})
local StatusClear       = TweenService:Create(Status,         FadeInfo,    {TextTransparency = 1})
local ExecLabelAppear   = TweenService:Create(ExecutorLabel,  FadeInfo,    {TextTransparency = 0})
local ExecLabelClear    = TweenService:Create(ExecutorLabel,  FadeInfo,    {TextTransparency = 1})

local FailTween   = TweenService:Create(LoadingBar, LoadingInfo, {BackgroundColor3 = Config.UI.Colors.Error})
local PassedTween = TweenService:Create(LoadingBar, LoadingInfo, {BackgroundColor3 = Config.UI.Colors.Success})

--// ================================================================
--// Core Logic
--// ================================================================
local currentPercentage = 0

getgenv().NextStep = function(targetPercentage, text, addwait)
    targetPercentage = math.clamp(targetPercentage, 0, 100)

    local LoadingTween = TweenService:Create(
        LoadingBar,
        LoadingInfo,
        {Size = UDim2.new((Config.UI.Sizes.BarWidth / 100) * targetPercentage, 0, Config.UI.Sizes.BarHeight, 0)}
    )

    if targetPercentage > currentPercentage then
        task.spawn(function()
            local Difference  = targetPercentage - currentPercentage
            local WaitTime    = Config.Animation.TweenDuration / Difference
            local SavedTarget = targetPercentage

            for i = currentPercentage + 1, targetPercentage do
                if SavedTarget ~= targetPercentage then break end
                Status.Text = string.format("%i%%", i)
                task.wait(WaitTime)
            end

            if SavedTarget == targetPercentage then
                Status.Text = string.format("%i%%", targetPercentage)
            end
        end)
    end

    currentPercentage  = targetPercentage
    Message.Text       = text
    LoadingTween:Play()

    if addwait then
        LoadingTween.Completed:Wait()
    end
end

local function DestroyBar()
    if LoadingBar.BackgroundColor3 == Config.UI.Colors.Error then
        local CloseTween = TweenService:Create(LoadingBar, LoadingInfo, {
            Size = UDim2.new(0, LoadingBar.AbsoluteSize.Y, Config.UI.Sizes.BarHeight, 0),
            BackgroundTransparency = 1
        })

        task.spawn(function()
            local Current = tonumber(string.match(Status.Text, "%d+")) or 0
            if Current > 0 then
                local WaitTime = Config.Animation.TweenDuration / Current
                for i = Current - 1, 0, -1 do
                    Status.Text = string.format("%i%%", i)
                    task.wait(WaitTime)
                end
                Status.Text = "0%"
            end
        end)

        CloseTween:Play()
        CloseTween.Completed:Wait()
    end

    BackdropDisappear:Play()
    BGDisappear:Play()
    BarDisappear:Play()
    MessageClear:Play()
    StatusClear:Play()
    ExecLabelClear:Play()

    BarDisappear.Completed:Wait()
    ScreenGui:Destroy()
end

--// ================================================================
--// Loading States
--// ================================================================

-- Shared early-stage states (same for all games)
local EarlyStates = {
    {Percent = 10, Text = "Starting " .. ExecutorName .. " environment...", Delay = 0.3},
    {Percent = 22, Text = "Hooking memory read/write functions...",          Delay = 0.6},
    {Percent = 35, Text = "Bypassing game integrity checks...",              Delay = 0.7},
    {Percent = 48, Text = "Resolving function addresses...",                 Delay = 0.5},
}

-- Game-specific states (appear after early stages)
local GameStates
if isFlingGame then
    GameStates = {
        {Percent = 58, Text = "Fling Things and People Script detected!",   Delay = 0.4},
        {Percent = 68, Text = "Loading fling physics module...",             Delay = 0.6},
        {Percent = 78, Text = "Injecting velocity manipulation hooks...",    Delay = 0.5},
        {Percent = 88, Text = "Patching ragdoll constraints...",             Delay = 0.5},
        {Percent = 95, Text = "Finalizing fling script...",                 Delay = 0.4},
    }
else
    GameStates = {
        {Percent = 58, Text = "Scanning game environment...",               Delay = 0.4},
        {Percent = 68, Text = "Loading universal module...",                Delay = 0.6},
        {Percent = 78, Text = "Hooking remote event handlers...",           Delay = 0.5},
        {Percent = 88, Text = "Applying compatibility patches...",          Delay = 0.5},
        {Percent = 95, Text = "Finalizing universal script...",             Delay = 0.4},
    }
end

--// ================================================================
--// Execution
--// ================================================================
BackdropAppear:Play()
BGAppear:Play()
ExecLabelAppear:Play()

task.spawn(function()
    task.wait(Config.Animation.FadeDuration / 2)

    -- Run early shared states
    for _, State in ipairs(EarlyStates) do
        task.wait(State.Delay)
        getgenv().NextStep(State.Percent, State.Text, true)
    end

    -- Run game-specific states
    for _, State in ipairs(GameStates) do
        task.wait(State.Delay)
        getgenv().NextStep(State.Percent, State.Text, true)
    end

    -- Final step
    task.wait(0.3)
    getgenv().NextStep(100, "Injecting...", true)

    -- Success animation
    task.wait(0.3)
    PassedTween:Play()
    Message.Text = "Done."
    PassedTween.Completed:Wait()

    task.wait(0.8)
    DestroyBar()

    -- ================================================================
    --  SCRIPT EXECUTION — runs only after the bar fully completes
    -- ================================================================
    if isFlingGame then
        task.spawn(RunFlingScript)
    else
        task.spawn(RunUniversalScript)
    end
end)
