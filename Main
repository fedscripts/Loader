    if input.UserInputType == AimbotSettings.AimbotBind then aiming = true  end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == AimbotSettings.AimbotBind then aiming = false end
end)

print("fedscripts | SolarisLib loaded successfully.")

