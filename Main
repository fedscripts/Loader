-- ─────────────────────────────────────────────────
--  PLAYER INFO UPDATE
-- ─────────────────────────────────────────────────
local lastSearchQuery = ""

local function updatePlayerInfo()
    local hrp = getHRP()
    if not hrp then return end
    local friendCount = 0
    local nearCount   = 0
    local target      = getClosestPlayer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == localPlayer then continue end
        if localPlayer:IsFriendsWith(p.UserId) then friendCount += 1 end
        local pHRP = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if pHRP and (hrp.Position - pHRP.Position).Magnitude < 50 then
            nearCount += 1
        end
    end
    pcall(function() friendCountLabel:Set("Friends in Server: " .. friendCount) end)
    pcall(function() nearCountLabel:Set("Players Nearby (<50): " .. nearCount) end)
    pcall(function() targetLabel:Set("Target: " .. (target and target.Name or "None")) end)

    local query = TeleportSettings.TargetPlayer or ""
    if query ~= lastSearchQuery then
        lastSearchQuery = query
        if query == "" then
            pcall(function() searchStatusLabel:Set("Status: Enter a name above") end)
        else
            local names = parsePlayerList(query)
            local allFound = true
            local foundNames = {}
            for _, name in ipairs(names) do
                local found = findPlayerByNameOrDisplay(name)
                if found then
                    foundNames[#foundNames+1] = found.Name
                else
                    allFound = false
                end
            end
            if #names == 0 then
                pcall(function() searchStatusLabel:Set("Status: Enter a name above") end)
            elseif allFound then
                local txt = "Found: " .. table.concat(foundNames, ", ")
                pcall(function() searchStatusLabel:Set(txt) end)
            else
                pcall(function() searchStatusLabel:Set("Not found in server") end)
            end
        end
    end
end

-- ─────────────────────────────────────────────────
--  MAIN RENDER / HEARTBEAT LOOPS
-- ─────────────────────────────────────────────────
RunService.RenderStepped:Connect(function()
    local anyESP = ESPSettings.ShowBox or ESPSettings.ShowName or ESPSettings.ShowHealth
                or ESPSettings.ShowDistance or ESPSettings.ShowTracer
    if not anyESP then
        for player in pairs(espBoxDrawings) do
            local b   = espBoxDrawings[player]      if b   then b.Visible   = false end
            local n   = espNameDrawings[player]     if n   then n.Visible   = false end
            local hbg = espHealthBGDrawings[player] if hbg then hbg.Visible = false end
            local hb  = espHealthDrawings[player]   if hb  then hb.Visible  = false end
            local d   = espDistDrawings[player]     if d   then d.Visible   = false end
            local t   = espTracerDrawings[player]   if t   then t.Visible   = false end
        end
        return
    end
    for player in pairs(espBoxDrawings) do
        updateESPForPlayer(player)
    end
end)

RunService:BindToRenderStep("FedAimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if fovCircle then
        fovCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        fovCircle.Radius   = AimbotSettings.FOV
    end

    if AimbotSettings.Enabled and aiming then
        local target = getClosestPlayer()
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            if head then
                local cameraPos = camera.CFrame.Position
                local newCF     = CFrame.new(cameraPos, head.Position)
                local smooth    = math.clamp(1 - (AimbotSettings.Smoothing / 100), 0.01, 1)
                if AimbotSettings.RageAim then
                    camera.CFrame = newCF
                else
                    camera.CFrame = camera.CFrame:Lerp(newCF, smooth)
                end
            end
        end
    end

    if AimbotSettings.SilentAim then
        local target = getClosestPlayer()
        if target and target.Character then
            local bone = getBonePart(target.Character, AimbotSettings.Bone) or target.Character:FindFirstChild("Head")
            silentTarget = bone and bone.Position or nil
        else
            silentTarget = nil
        end
    else
        silentTarget = nil
    end

    if AimbotSettings.TriggerBot then
        for _, player in ipairs(Players:GetPlayers()) do
            if player == localPlayer then continue end
            if not isAlive(player) then continue end
            local character = player.Character
            if not character then continue end
            local head = character:FindFirstChild("Head")
            if not head then continue end
            local camCF    = camera.CFrame
            local toTarget = (head.Position - camCF.Position).Unit
            local dot      = camCF.LookVector:Dot(toTarget)
            if dot > 0.985 then
                mouse1click()
                break
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    updatePlayerInfo()
end)

