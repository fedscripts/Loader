

local function RunFlingScript()

    -- Orbit | Fling Things and People
-- Converted to SolarisLib

local SolarisLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/fedscripts/Orbit-UI/refs/heads/main/Library", true))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- =============================================
-- CORE REFERENCES (from original script)
-- =============================================
local CharacterEvents = ReplicatedStorage:WaitForChild("CharacterEvents")
local GrabEvents = ReplicatedStorage:WaitForChild("GrabEvents")
local _SetNetworkOwner = GrabEvents:WaitForChild("SetNetworkOwner")
local _DestroyGrabLine = GrabEvents:WaitForChild("DestroyGrabLine")
local _CreateGrabLine = GrabEvents:WaitForChild("CreateGrabLine")
local _RagdollRemote = CharacterEvents:WaitForChild("RagdollRemote")
local _Struggle = CharacterEvents:WaitForChild("Struggle")
local _IsHeld = LocalPlayer:WaitForChild("IsHeld")
local _InPlot = LocalPlayer:WaitForChild("InPlot")
local PoisonBig = Workspace.Map.Hole.PoisonBigHole.PoisonHurtPart
local PoisonSmall = Workspace.Map.Hole.PoisonSmallHole.PoisonHurtPart
local PoisonFactory = Workspace.Map.FactoryIsland.PoisonContainer.PoisonHurtPart

PoisonBig.Size = Vector3.new(2,2,2)
PoisonSmall.Size = Vector3.new(2,2,2)
PoisonFactory.Size = Vector3.new(2,2,2)
PoisonBig.Position = Vector3.new(0,-50,0)
PoisonSmall.Position = Vector3.new(0,-50,0)
PoisonFactory.Position = Vector3.new(0,-50,0)

local apagarfogo = Workspace.Map.Hole.PoisonBigHole.ExtinguishPart
apagarfogo.Size = Vector3.new(0.5,0.5,0.5)
apagarfogo.Transparency = 1

local SpawnToyRF = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local DeleteToyRE = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("DestroyToy")

local _OuterUFO = Workspace.Map.AlwaysHereTweenedObjects:FindFirstChild("OuterUFO")
if _OuterUFO and _OuterUFO:FindFirstChild("Object") and _OuterUFO.Object:FindFirstChild("ObjectModel") then
	_OuterUFO = _OuterUFO.Object.ObjectModel.PaintPlayerPart
	_OuterUFO:WaitForChild("WeldConstraint").Enabled = false
	_OuterUFO.Anchored = true
	_OuterUFO.Shape = Enum.PartType.Block
	_OuterUFO.Transparency = 1
	_OuterUFO.Size = Vector3.new(0.5, 0.5, 0.5)
	_OuterUFO.Position = Vector3.new(0, -50, 0)
end

-- =============================================
-- HELPER FUNCTIONS
-- =============================================
local function GetPlayerCharacter()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
		return char
	end
end

local function GetPlayerRoot()
	local char = GetPlayerCharacter()
	if char then return char.HumanoidRootPart end
end

local function GetPlayerCFrame()
	local root = GetPlayerRoot()
	if root then return root.CFrame end
end

local function TeleportPlayer(cf)
	local char = GetPlayerCharacter()
	if char then
		char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame.Rotation + cf.Position
		char:FindFirstChildOfClass("Humanoid").Sit = false
	end
end

local function lookAt(from, to)
	local unit = (to - from).Unit
	local right = unit:Cross(Vector3.new(0,1,0))
	local up = right:Cross(unit)
	return CFrame.fromMatrix(from, right, up)
end

local function SNOWshipPlayer(player, callback)
	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local dist = LocalPlayer:DistanceFromCharacter(hrp.Position)
			local partowner = hrp:FindFirstChild("PartOwner")
			if partowner and partowner.Value == LocalPlayer.Name then
				if type(callback) == "function" then callback() end
				return true
			end
			if dist <= 30 then
				_SetNetworkOwner:FireServer(hrp, lookAt(LocalPlayer.Character.HumanoidRootPart.Position, hrp.Position))
			end
		end
	end
end

local function SNOWship(part)
	if part and typeof(part) == "Instance" then
		local dist = LocalPlayer:DistanceFromCharacter(part.Position)
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and dist <= 30 then
			_SetNetworkOwner:FireServer(part, lookAt(LocalPlayer.Character.HumanoidRootPart.Position, part.Position))
		end
	end
end

local function CheckPlayer(p)
	if typeof(p) == "Instance" and p ~= LocalPlayer and p.Character and p.Character:IsDescendantOf(Workspace) then
		local hrp = p.Character:FindFirstChild("HumanoidRootPart")
		local hum = p.Character:FindFirstChildOfClass("Humanoid")
		if hrp and hum and hum.Health > 0 then return true end
	end
end

local function IsPlayerInsideSafeZone(p)
	if typeof(p) == "Instance" and p:IsA("Player") and p:FindFirstChild("InPlot") and p.InPlot.Value then
		return true
	end
end

local function CheckPlayerForLoopKill(p)
	if CheckPlayer(p) and not IsPlayerInsideSafeZone(p) then
		return true
	end
end

local function CreateSkyVelocity(part)
	if not part:FindFirstChild("SkyVelocity") then
		local bv = Instance.new("BodyVelocity", part)
		bv.Name = "SkyVelocity"
		bv.Velocity = Vector3.new(0, 100000000000000, 0)
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	end
end

-- CheckNetworkOwnerShipOnPlayer (from Bliz script)
local function CheckNetworkOwnerShipOnPlayer(p, p2)
	if typeof(p) == "Instance" and (p:IsA("Player") and p.Character) and (p.Character:FindFirstChild("Head") and (p.Character.Head:FindFirstChild("PartOwner") and p.Character.Head.PartOwner.Value == LocalPlayer.Name)) then
		return not p2 and true or p.Character.Head.PartOwner
	end
end

local Camera = Workspace.CurrentCamera

-- =============================================
-- Campfire burn function (u613 equivalent) -- needed for Burn Grab
-- =============================================
local _Debris = game:GetService("Debris")

local holdfirePartFound = nil

local function checkHoldFirePart()
	local v584 = LocalPlayer:WaitForChild(LocalPlayer.Name .. "SpawnedInToys") or Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
	if not v584 then return end
	local v588 = nil
	for _, v589 in pairs(v584:GetChildren()) do
		if v589.Name == "Campfire" and not v589:GetAttribute("FirePlayerPart") then
			if v589.FirePlayerPart.CanBurn.Value then
				v588 = v589
			end
		end
	end
	if not v588 then
		local v590 = {
			"Campfire",
			CFrame.new(508.073517, 67.2614441, -261.901917, -0.133750245, -0.471861839, 0.871468484, -3.7252903e-9, 0.879369617, 0.476139903, -0.991015136, 0.0636838302, -0.117615893),
			Vector3.new(0, 97.69000244140625, 0),
		}
		SpawnToyRF:InvokeServer(unpack(v590))
	end
	holdfirePartFound = v588
end

local u583 = nil

local function u591()
	if holdfirePartFound and holdfirePartFound.Parent ~= nil then
		return holdfirePartFound
	end
	checkHoldFirePart()
end

local u17 = nil
task.spawn(function()
	u17 = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
end)

local function SetModelProperties(p444)
	for _, v448 in pairs(p444:GetDescendants()) do
		if v448:IsA("BasePart") then
			v448.CanCollide = false
		end
	end
end

local function u604()
	if not u17 then return end
	local v592 = GetPlayerCFrame()
	local u597 = nil
	local u598 = nil
	for _, v599 in pairs(u17:GetChildren()) do
		if v599.Name == "Campfire" and v599.PrimaryPart then
			if LocalPlayer:DistanceFromCharacter(v599.PrimaryPart.Position) < 30 and v599.FirePlayerPart.CanBurn.Value then
				u597 = v599
			end
		end
	end
	if not u597 then
		if v592 then
			local v600 = {
				"Campfire",
				CFrame.new(v592.Position.X, v592.Position.Y, v592.Position.Z, -0.133750245, -0.471861839, 0.871468484, -3.7252903e-9, 0.879369617, 0.476139903, -0.991015136, 0.0636838302, -0.117615893),
				Vector3.new(0, 97.69000244140625, 0),
			}
			SpawnToyRF:InvokeServer(unpack(v600))
		end
	end
	if u597 and u597:FindFirstChild("FirePlayerPart") and (u597.FirePlayerPart:FindFirstChild("CanBurn") and not u597:GetAttribute("Connected2")) then
		local u602 = u597.DescendantAdded:Connect(function(p601)
			if p601.Name == "PartOwner" and p601.Value ~= LocalPlayer.Name then
				u597:SetAttribute("AlreadySetOwnerShip", false)
			end
		end)
		task.spawn(function()
			u598 = u597.FirePlayerPart
			while u597.Parent do
				local v603 = not u597.FirePlayerPart.CanBurn.Value and u591()
				if v603 then
					u598.Position = v603.FirePlayerPart.Position
				end
				if not u597:GetAttribute("AlreadySetOwnerShip") then
					local SNOWshipOnce_hrp = u598
					local dist2 = LocalPlayer:DistanceFromCharacter(SNOWshipOnce_hrp.Position)
					if dist2 <= 30 then
						_SetNetworkOwner:FireServer(SNOWshipOnce_hrp, lookAt(LocalPlayer.Character.HumanoidRootPart.Position, SNOWshipOnce_hrp.Position))
						u597:SetAttribute("AlreadySetOwnerShip", true)
					elseif dist2 > 30 then
						DeleteToyRE:FireServer(u597)
					end
				end
				task.wait(0.1)
			end
			u602:Disconnect()
		end)
		u597:SetAttribute("Connected2", true)
	end
	u583 = u597
end

local function u605()
	if u583 and u583.Parent ~= nil then
		return u583
	end
	u604()
end

local function u613(p606)
	local u607 = u605()
	local v608 = nil
	local _Character3 = LocalPlayer.Character
	if _Character3 then
		_Character3 = _Character3:FindFirstChild("Head")
	end
	if u607 then
		v608 = u607.PrimaryPart
	end
	if u607 and _Character3 and v608 then
		local _FirePlayerPart2 = u607:FindFirstChild("FirePlayerPart")
		local _CampfirePosRemove = v608:FindFirstChild("CampfirePosRemove")
		_FirePlayerPart2.Size = Vector3.new(2, 2, 2)
		if not _CampfirePosRemove and u607:GetAttribute("AlreadySetOwnerShip") then
			SetModelProperties(u607)
			local _BodyPosition4 = Instance.new("BodyPosition", u607.PrimaryPart)
			_BodyPosition4.Name = "CampfirePosRemove"
			_BodyPosition4.MaxForce = Vector3.new(12500, 12500, 12500)
			task.spawn(function()
				while u607.Parent do
					_BodyPosition4.Position = _Character3.Position + Vector3.new(5, 500, 0)
					task.wait()
				end
			end)
		end
		if _FirePlayerPart2 and p606 and (u607:GetAttribute("AlreadySetOwnerShip") and v608) then
			_FirePlayerPart2.Position = p606.Position
			task.wait()
			_FirePlayerPart2.Position = v608.Position
		end
	end
end

